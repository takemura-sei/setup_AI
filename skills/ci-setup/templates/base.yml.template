name: CI

on:
  pull_request:
    branches:
      - main
  push:
    branches:
      - main

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # pnpmを使う場合のみ、setup-nodeより前に以下を追加する:
      # - name: Setup pnpm
      #   uses: pnpm/action-setup@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "__NODE_VERSION__"
          cache: "npm"

      - name: Install dependencies
        run: __INSTALL_COMMAND__

# __STEPS__
